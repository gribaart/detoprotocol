# Gateway Configuration
GATEWAY_URL=ws://localhost:8080/ws/worker
GATEWAY_PORT=8080

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Worker Configuration
